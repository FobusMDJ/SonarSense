+                "confidence_score": 91.0, "confidence_label": "High",
+                "lat": geo.lat, "lon": geo.lon, "geo_method": "nav_fix",
+                "footprint_geojson": json.dumps([[lon, lat] for lat, lon in geo.footprint]),
+                "created_at": "2026-01-01T00:00:00Z",
+            })
